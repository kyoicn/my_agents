#!/usr/bin/env bash
# Refuse a commit whose staged Codex or Antigravity port is stale relative to the
# staged Claude sources. Activated per clone by `git config core.hooksPath .githooks`
# (claude/deploy.sh does this).
set -euo pipefail

if git diff --cached --quiet -- claude codex antigravity; then
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"

stale=0
for port in codex antigravity; do
  if ! bash "$tmp/$port/skills/sync-from-claude/scripts/sync-from-claude.sh" --check; then
    stale=1
  fi
done

if [[ $stale -eq 1 ]]; then
  echo "" >&2
  echo "pre-commit: a staged port does not match the staged Claude sources." >&2
  echo "Fix: run the sync script(s) listed above, then git add -A codex antigravity" >&2
  exit 1
fi
