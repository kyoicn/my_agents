{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "./scripts/qa-server.sh", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/qa-server.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/qa-android.sh", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/qa-android.sh *", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/qa-cli.sh", "effect": "allow" },
    { "action": "shell", "resource": "./scripts/qa-cli.sh *", "effect": "allow" }
  ]
}
