#!/usr/bin/env bash
# Refuse a commit whose staged Codex port is stale relative to the staged Claude sources.
# Activated per clone by `git config core.hooksPath .githooks` (claude/deploy.sh does this).
set -euo pipefail

if git diff --cached --quiet -- claude codex; then
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"

if ! bash "$tmp/codex/skills/sync-from-claude/scripts/sync-from-claude.sh" --check; then
  echo "" >&2
  echo "pre-commit: the staged Codex port does not match the staged Claude sources." >&2
  echo "Fix: ./codex/skills/sync-from-claude/scripts/sync-from-claude.sh && git add -A codex" >&2
  exit 1
fi
